// Persistointi: localStorage jos saatavilla (esim. itse hostattuna),
// muuten muistinvarainen fallback (nollautuu sivun uudelleenlatauksessa —
// tämä koskee erityisesti Claude.ai:n esikatselusandboxia, jossa
// localStorage on estetty).
const batchStore = (() => {
  let memory = {};
  let usable = false;
  try {
    window.localStorage.setItem('__batch_test__', '1');
    window.localStorage.removeItem('__batch_test__');
    usable = true;
  } catch (e) { usable = false; }
  return {
    get(key, fallback) {
      if (usable) {
        try { const v = window.localStorage.getItem(key); return v ? JSON.parse(v) : fallback; }
        catch (e) { return fallback; }
      }
      return (key in memory) ? memory[key] : fallback;
    },
    set(key, val) {
      if (usable) {
        try { window.localStorage.setItem(key, JSON.stringify(val)); return; }
        catch (e) { /* fall through to memory */ }
      }
      memory[key] = val;
    }
  };
})();

function todayKey() {
  // Paikallinen YYYY-MM-DD, käytetään "yksi erä per päivä" -tarkistukseen.
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}

let batchQueue = batchStore.get('batchQueue', []);
let batchState = batchStore.get('batchState', { batchId: null, dateKey: null, status: null, results: null, itemMeta: null });
let batchPollTimer = null;

function saveBatchQueue() { batchStore.set('batchQueue', batchQueue); }
function saveBatchState() { batchStore.set('batchState', batchState); }

function modeLabelShort(mode) {
  return { weekly:'Viikon katsaus', case:'Organisaatio muuttuu', framing:'Johtaja viestii', concern:'Huoli tai kritiikki' }[mode] || mode;
}

function queueForBatch() {
  const input = document.getElementById('queryInput').value.trim();
  if (!input) { alert('Syötä ensin materiaali tai kysymys ennen erään lisäämistä.'); return; }
  batchQueue.push({
    id: 'bq_' + Date.now() + '_' + Math.random().toString(36).slice(2,7),
    mode: currentMode,
    input,
    lenses: [...activeLenses],
    addedAt: new Date().toISOString()
  });
  saveBatchQueue();
  document.getElementById('queryInput').value = '';
  renderBatchPanel();
}

function removeFromQueue(id) {
  batchQueue = batchQueue.filter(item => item.id !== id);
  saveBatchQueue();
  renderBatchPanel();
}

function renderBatchPanel() {
  const panel = document.getElementById('batchPanel');
  const listEl = document.getElementById('batchQueueList');
  const submitBtn = document.getElementById('submitBatchBtn');
  const statusEl = document.getElementById('batchStatusText');
  const dateLabel = document.getElementById('batchDateLabel');
  const resultsEl = document.getElementById('batchResultsList');

  const hasQueue = batchQueue.length > 0;
  const hasActiveBatch = !!batchState.batchId;
  panel.style.display = (hasQueue || hasActiveBatch) ? 'block' : 'none';
  if (!hasQueue && !hasActiveBatch) return;

  dateLabel.textContent = todayKey();

  listEl.innerHTML = hasQueue
    ? batchQueue.map(item => `
      <div class="batch-queue-item">
        <span>${modeLabelShort(item.mode)} — "${item.input.slice(0,60).replace(/</g,'&lt;')}${item.input.length>60?'…':''}"</span>
        <span class="bq-meta">
          ${item.lenses.length} linssiä
          <button class="bq-remove" onclick="removeFromQueue('${item.id}')" title="Poista jonosta">✕</button>
        </span>
      </div>`).join('')
    : `<div class="batch-empty-hint">Ei jonotettuja analyyseja. Erä on jo lähetetty tälle päivälle (alla).</div>`;

  const alreadySubmittedToday = batchState.dateKey === todayKey() && batchState.batchId;
  submitBtn.disabled = !hasQueue || alreadySubmittedToday;
  submitBtn.textContent = alreadySubmittedToday ? '📤 Erä jo lähetetty tänään' : `📤 Lähetä päivän erä (${batchQueue.length})`;

  if (batchState.batchId) {
    let statusMsg = '';
    if (batchState.status === 'in_progress') statusMsg = `⏳ Erä ${batchState.batchId} käsittelyssä...`;
    else if (batchState.status === 'ended') statusMsg = `✅ Erä ${batchState.batchId} valmis.`;
    else if (batchState.status === 'error') statusMsg = `⚠️ Virhe erän haussa.`;
    statusEl.textContent = statusMsg;
  } else {
    statusEl.textContent = '';
  }

  if (batchState.results) {
    resultsEl.innerHTML = batchState.results.map((r, i) => {
      const meta = (batchState.itemMeta || [])[i] || {};
      if (r.error) {
        return `<div class="batch-result-item errored">
          <span>${modeLabelShort(meta.mode)} — ${meta.preview || ''}</span>
          <span class="br-error">Epäonnistui: ${r.error}</span>
        </div>`;
      }
      return `<div class="batch-result-item">
        <span>${modeLabelShort(meta.mode)} — ${meta.preview || ''}</span>
        <button class="br-view-btn" onclick="showBatchResult(${i})">Näytä analyysi</button>
      </div>`;
    }).join('');
  } else {
    resultsEl.innerHTML = '';
  }
}

function showBatchResult(index) {
  const r = batchState.results[index];
  if (!r || r.error) return;
  lastAnalysis = r.analysis;
  document.getElementById('globalFactsheetBtn').disabled = false;
  const responseArea = document.getElementById('responseArea');
  responseArea.className = 'response-area visible';
  responseArea.innerHTML = renderResponse(r.analysis);
  setupSectionToggles();
  responseArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

async function submitDailyBatch() {
  if (batchQueue.length === 0) return;
  if (batchState.dateKey === todayKey() && batchState.batchId) {
    alert('Päivän erä on jo lähetetty. Yksi erä / päivä -sääntö estää toisen lähetyksen tänään. Tarkista tulokset alta, kun erä on valmis.');
    return;
  }
  const apiKey = getApiKey();
  if (!apiKey) { alert('Syötä API-avain ennen erän lähettämistä.'); return; }

  const submitBtn = document.getElementById('submitBatchBtn');
  submitBtn.disabled = true;
  submitBtn.textContent = '📤 Lähetetään...';

  const itemMeta = batchQueue.map(item => ({
    mode: item.mode,
    preview: item.input.slice(0,50).replace(/</g,'&lt;') + (item.input.length>50?'…':'')
  }));

  const requests = batchQueue.map((item, idx) => ({
    custom_id: `req_${idx}_${item.id}`,
    params: {
      model: 'claude-sonnet-4-6',
      max_tokens: 8000,
      system: buildSystemPrompt(new Set(item.lenses)),
      messages: [{ role: 'user', content: buildUserPrompt(item.input, item.mode, new Set(item.lenses)) }],
      tools: [{ type: 'web_search_20250305', name: 'web_search' }]
    }
  }));

  try {
    const resp = await fetch('https://api.anthropic.com/v1/messages/batches', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01',
        'anthropic-beta': 'prompt-caching-2024-07-31,message-batches-2024-09-24',
        'anthropic-dangerous-direct-browser-access': 'true'
      },
      body: JSON.stringify({ requests })
    });
    if (!resp.ok) throw new Error(`Batch-API-virhe: ${resp.status}`);
    const data = await resp.json();

    batchState = { batchId: data.id, dateKey: todayKey(), status: data.processing_status || 'in_progress', results: null, itemMeta };
    saveBatchState();
    batchQueue = [];
    saveBatchQueue();
    renderBatchPanel();
    pollBatchStatus();
  } catch (err) {
    alert('Erän lähetys epäonnistui: ' + err.message);
    submitBtn.disabled = false;
    renderBatchPanel();
  }
}

async function pollBatchStatus() {
  if (!batchState.batchId || batchState.status === 'ended') return;
  const apiKey = getApiKey();
  if (!apiKey) return;

  clearTimeout(batchPollTimer);

  try {
    const resp = await fetch(`https://api.anthropic.com/v1/messages/batches/${batchState.batchId}`, {
      headers: {
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01',
        'anthropic-dangerous-direct-browser-access': 'true'
      }
    });
    if (!resp.ok) throw new Error(`Batch-tila-API-virhe: ${resp.status}`);
    const data = await resp.json();
    batchState.status = data.processing_status;
    saveBatchState();
    renderBatchPanel();

    if (data.processing_status === 'ended') {
      await fetchBatchResults(data.results_url);
    } else {
      batchPollTimer = setTimeout(pollBatchStatus, 30000); // 30s välein — batchit eivät ole reaaliaikaisia
    }
  } catch (err) {
    batchState.status = 'error';
    saveBatchState();
    renderBatchPanel();
  }
}

async function fetchBatchResults(resultsUrl) {
  const apiKey = getApiKey();
  try {
    const resp = await fetch(resultsUrl, {
      headers: {
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01',
        'anthropic-dangerous-direct-browser-access': 'true'
      }
    });
    if (!resp.ok) throw new Error(`Tulosten haku epäonnistui: ${resp.status}`);
    const text = await resp.text();
    const lines = text.trim().split('\n').filter(Boolean);

    // Tulokset saattavat tulla eri järjestyksessä kuin lähetettiin — järjestetään custom_id:n mukaan.
    const byCustomId = {};
    lines.forEach(line => {
      try {
        const obj = JSON.parse(line);
        byCustomId[obj.custom_id] = obj;
      } catch (e) { /* ohita virheellinen rivi */ }
    });

    const orderedIds = (batchState.itemMeta || []).map((m, idx) => {
      // custom_id-muoto on req_{idx}_{itemId}; etsitään vastaava alkuperäinen indeksi
      return Object.keys(byCustomId).find(cid => cid.startsWith(`req_${idx}_`));
    });

    const results = orderedIds.map(cid => {
      const obj = byCustomId[cid];
      if (!obj || obj.result?.type !== 'succeeded') {
        return { error: obj?.result?.error?.message || obj?.result?.type || 'tuntematon virhe' };
      }
      const content = obj.result.message.content || [];
      const textBlocks = content.filter(b => b.type === 'text');
      const raw = textBlocks.length ? textBlocks[textBlocks.length - 1].text : '';
      try {
        return { analysis: extractJSON(raw, null) };
      } catch (e) {
        return { error: e.message };
      }
    });

    batchState.results = results;
    saveBatchState();
    renderBatchPanel();
  } catch (err) {
    batchState.status = 'error';
    saveBatchState();
    renderBatchPanel();
  }
}

document.getElementById('batchAddBtn').addEventListener('click', queueForBatch);
document.getElementById('submitBatchBtn').addEventListener('click', submitDailyBatch);
renderBatchPanel();
// Jos edellisen session erä oli vielä kesken, jatka pollausta
if (batchState.batchId && batchState.status !== 'ended') { pollBatchStatus(); }

