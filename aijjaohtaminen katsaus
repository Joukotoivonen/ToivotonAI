// ── Robusti JSON-ekstraktori — toimii myös kun malli kirjoittaa tekstiä ennen tai jälkeen JSON:in ──
function extractJSON(raw, stopReason, maxTokensMsg) {
  if (stopReason === 'max_tokens') {
    throw new Error(maxTokensMsg || 'Vastaus katkesi token-rajan takia (max_tokens saavutettu). Yritä lyhyemmällä syötteellä.');
  }
  // 1) Kokeile ensin suoraan (jos malli palautti puhdasta JSON:ia tai ```json-blokin)
  try {
    const clean = raw.replace(/```json\s*|```/g, '').trim();
    return JSON.parse(clean);
  } catch (_) { /* jatka */ }
  // 2) Etsi ensimmäinen '{' ja viimeinen '}' — leikkaa preambuli ja postambuli pois
  const start = raw.indexOf('{');
  const end = raw.lastIndexOf('}');
  if (start !== -1 && end !== -1 && end > start) {
    try {
      return JSON.parse(raw.slice(start, end + 1));
    } catch (_) { /* jatka */ }
  }
  // 3) Kaikki epäonnistui
  throw new Error('JSON-parsinta epäonnistui. Vastauksen alku: ' + raw.slice(0, 200));
}

// ── Cache-tilastojen näyttö (läpinäkyvyys: kuinka paljon säästettiin) ──
function renderCacheStats(usage) {
  if (!usage) return '';
  const created = usage.cache_creation_input_tokens || 0;
  const read = usage.cache_read_input_tokens || 0;
  if (!created && !read) return '';
  const label = read > 0
    ? `📦 Cache read: ${read.toLocaleString('fi-FI')} tokenia luettu cachesta (halvempi kutsu)`
    : `📦 Cache write: ${created.toLocaleString('fi-FI')} tokenia tallennettu cacheen (seuraavat kutsut halvempia)`;
  return `<div style="margin-top:14px; padding:8px 12px; border-radius:8px; background:var(--bg-card2); border:1px solid var(--border); font-size:12px; color:var(--muted);">${label}</div>`;
}

