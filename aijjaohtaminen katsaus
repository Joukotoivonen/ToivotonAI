async function runAnalysis() {
  const input = document.getElementById('queryInput').value.trim();
  const runBtn = document.getElementById('runBtn');
  const responseArea = document.getElementById('responseArea');

  runBtn.disabled = true;
  runBtn.innerHTML = '<span class="spinner" style="width:18px;height:18px;border-width:2px;margin:0;"></span> Analysoidaan...';
  responseArea.className = 'response-area visible';

  const steps = [
    { id:'s1', text:'Haetaan relevantti konteksti teoriakehyksistä...' },
    { id:'s2', text:'Sovelletaan keskijohdon linssejä...' },
    { id:'s3', text:'Tunnistetaan kehystämistoimet...' },
    { id:'s4', text:'Rakennetaan kilpailevien kehysten radar...' },
    { id:'s5', text:'Muodostetaan viikottainen katsaus...' }
  ];

  responseArea.innerHTML = `<div class="loading-card">
    <div class="spinner"></div>
    <div style="font-size:15px; font-weight:700; margin-bottom:4px;">Analysoidaan teoriakehysten kautta...</div>
    <div style="font-size:13px; color:var(--muted);">Aktiiviset linssit: ${[...activeLenses].map(l => ({'1a':'Oppiminen','1b':'Keskijohto','2a':'Kehykset','2b':'Teknologia'})[l]).join(', ')}</div>
    <div class="loading-steps" id="loadingSteps">
      ${steps.map(s => `<div class="loading-step" id="${s.id}"><span class="step-icon">○</span>${s.text}</div>`).join('')}
    </div>
  </div>`;

  const apiKey = getApiKey();
  if (!apiKey) {
    responseArea.className = 'response-area visible';
    responseArea.innerHTML = `<div class="error-card">
      <div style="font-size:16px; font-weight:700; margin-bottom:8px;">🔑 API-avain puuttuu</div>
      <div>Syötä Anthropic API-avain oikeaan yläkulmaan ennen analyysin ajamista.<br>Avain alkaa <code style="font-family:monospace; background:rgba(255,255,255,0.1); padding:1px 5px; border-radius:3px;">sk-ant-</code> ja löytyy osoitteesta <a href="https://console.anthropic.com/settings/keys" target="_blank" class="source-link">console.anthropic.com</a>.</div>
    </div>`;
    runBtn.disabled = false;
    runBtn.innerHTML = '<span>▶ Analysoi</span>';
    return;
  }

  // Animate steps
  let stepIdx = 0;
  const stepInterval = setInterval(() => {
    if (stepIdx > 0) {
      const prev = document.getElementById(steps[stepIdx-1].id);
      if (prev) { prev.classList.add('done'); prev.querySelector('.step-icon').textContent = '✓'; }
    }
    if (stepIdx < steps.length) stepIdx++;
  }, 900);

  try {
    const messages = [{ role: 'user', content: buildUserPrompt(input, currentMode, activeLenses) }];

    const resp = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01',
        'anthropic-beta': 'prompt-caching-2024-07-31',
        'anthropic-dangerous-direct-browser-access': 'true'
      },
      body: JSON.stringify({
        model: 'claude-sonnet-4-6',
        max_tokens: 8000,
        system: buildSystemPrompt(),
        messages,
        tools: [{ type: 'web_search_20250305', name: 'web_search' }]
      })
    });

    clearInterval(stepInterval);
    steps.forEach((s,i) => {
      const el = document.getElementById(s.id);
      if (el) { el.classList.add('done'); el.querySelector('.step-icon').textContent = '✓'; }
    });

    if (!resp.ok) throw new Error(`API-virhe: ${resp.status}`);
    const data = await resp.json();
    const textBlocks = data.content.filter(b => b.type === 'text');
    const raw = textBlocks.length ? textBlocks[textBlocks.length - 1].text : '';
    const stopReason = data.stop_reason;
    const parsed = extractJSON(raw, stopReason);

    lastAnalysis = parsed;
    document.getElementById('globalFactsheetBtn').disabled = false;

    await new Promise(r => setTimeout(r, 400));
    responseArea.innerHTML = renderResponse(parsed) + renderCacheStats(data.usage);
    setupSectionToggles();

  } catch(err) {
    clearInterval(stepInterval);
    responseArea.innerHTML = `<div class="error-card">
      <div style="font-size:16px; font-weight:700; margin-bottom:8px;">⚠️ Virhe analyysissä</div>
      <div>${err.message}</div>
    </div>`;
  } finally {
    runBtn.disabled = false;
    runBtn.innerHTML = '<span>▶ Analysoi</span>';
  }
}

document.getElementById('runBtn').addEventListener('click', runAnalysis);

