<html lang="fi"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tekoäly &amp; Johtaminen — Viikottainen Katsaus</title>
<link rel="icon" href="data:image/svg+xml,&lt;svg xmlns=&#39;http://www.w3.org/2000/svg&#39; viewBox=&#39;0 0 100 100&#39;&gt;&lt;rect width=&#39;100&#39; height=&#39;100&#39; rx=&#39;18&#39; fill=&#39;%231E2433&#39;/&gt;&lt;text y=&#39;68&#39; x=&#39;50&#39; text-anchor=&#39;middle&#39; font-size=&#39;58&#39;&gt;%F0%9F%94%AC&lt;/text&gt;&lt;/svg&gt;">
<style>
  :root {
    --bg-deep:    #141820;
    --bg-card:    #1E2433;
    --bg-card2:   #252B3B;
    --border:     #2E3650;
    --text:       #E8ECF4;
    --muted:      #8A93A8;
    --ritala:     #3B7DD8;   /* Linssi 1 — organisatorinen oppiminen */
    --floyd:      #5BB5A2;   /* Linssi 1b — keskijohdon rooli */
    --kaplan:     #D4A843;   /* Linssi 2a — framing contests */
    --hoppmann:   #C26EBF;   /* Linssi 2b — teknologinen kehystäminen */
    --warning:    #E05C5C;
    --success:    #5BB57A;
    --font-ui:    'Inter', 'Segoe UI', system-ui, sans-serif;
    --font-mono:  'JetBrains Mono', 'Fira Code', monospace;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg-deep);
    color: var(--text);
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.65;
    min-height: 100vh;
  }

  /* ── HEADER ── */
  header {
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
    padding: 20px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-icon {
    width: 36px; height: 36px;
    background: linear-gradient(135deg, var(--ritala), var(--kaplan));
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .brand h1 {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.3px;
    color: var(--text);
  }

  .brand p {
    font-size: 12px;
    color: var(--muted);
    margin-top: 1px;
  }

  .header-actions {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  /* ── API KEY ── */
  .apikey-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 6px 12px;
    transition: border-color 0.15s;
  }
  .apikey-wrap:focus-within { border-color: var(--ritala); }
  .apikey-wrap label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--muted);
    white-space: nowrap;
  }
  .apikey-wrap input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 12px;
    width: 200px;
    letter-spacing: 0.5px;
  }
  .apikey-wrap input::placeholder { color: var(--border); }
  .apikey-status {
    font-size: 16px;
    line-height: 1;
  }

  /* ── LENS PILLS ── */
  .lens-bar {
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
    padding: 10px 32px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }

  .lens-label {
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-right: 4px;
  }

  .lens-pill {
    font-size: 12px;
    font-weight: 600;
    padding: 4px 11px;
    border-radius: 20px;
    border: none;
    cursor: default;
    letter-spacing: 0.1px;
    transition: opacity 0.2s, filter 0.2s;
  }

  .lens-pill.inactive {
    opacity: 0.28;
    filter: grayscale(70%);
    text-decoration: line-through;
    text-decoration-color: rgba(255,255,255,0.4);
  }

  .pill-1a  { background: rgba(59,125,216,0.18); color: var(--ritala); border: 1px solid rgba(59,125,216,0.35); }
  .pill-1b  { background: rgba(91,181,162,0.18); color: var(--floyd);  border: 1px solid rgba(91,181,162,0.35); }
  .pill-2a  { background: rgba(212,168,67,0.18); color: var(--kaplan); border: 1px solid rgba(212,168,67,0.35); }
  .pill-2b  { background: rgba(194,110,191,0.18); color: var(--hoppmann); border: 1px solid rgba(194,110,191,0.35); }

  /* ── MAIN LAYOUT ── */
  .layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    min-height: calc(100vh - 100px);
  }

  /* ── SIDEBAR ── */
  aside {
    background: var(--bg-card);
    border-right: 1px solid var(--border);
    padding: 24px 20px;
    overflow-y: auto;
    position: sticky;
    top: 100px;
    height: calc(100vh - 100px);
  }

  .aside-section { margin-bottom: 28px; }

  .aside-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
    margin-bottom: 12px;
  }

  /* Lens cards in sidebar */
  .lens-card {
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 8px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: border-color 0.15s, opacity 0.2s, filter 0.2s;
  }
  .lens-card:hover { border-color: var(--border); }
  .lens-card.inactive { opacity: 0.3; filter: grayscale(60%); }
  .lens-card.l1a { background: rgba(59,125,216,0.08); }
  .lens-card.l1b { background: rgba(91,181,162,0.08); }
  .lens-card.l2a { background: rgba(212,168,67,0.08); }
  .lens-card.l2b { background: rgba(194,110,191,0.08); }

  .lens-card-header {
    display: flex; align-items: center; gap: 8px;
    margin-bottom: 4px;
  }
  .lens-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .lens-card-title { font-size: 12px; font-weight: 700; }
  .lens-card-sub   { font-size: 11px; color: var(--muted); margin-top: 2px; }
  .lens-concepts   { font-size: 11px; color: var(--muted); margin-top: 6px; font-style: italic; }

  /* Framing dimensions mini-legend */
  .dim-row {
    display: flex; align-items: center; gap: 8px;
    padding: 5px 0;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
  }
  .dim-row:last-child { border-bottom: none; }
  .dim-badge {
    font-size: 10px; font-weight: 700;
    padding: 2px 7px; border-radius: 4px;
    min-width: 70px; text-align: center;
    background: rgba(194,110,191,0.15); color: var(--hoppmann);
  }
  .tactic-badge {
    font-size: 10px; font-weight: 700;
    padding: 2px 7px; border-radius: 4px;
    min-width: 80px; text-align: center;
    background: rgba(212,168,67,0.12); color: var(--kaplan);
  }

  /* Floyd roles */
  .role-row {
    display: flex; align-items: flex-start; gap: 8px;
    padding: 5px 0;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
  }
  .role-row:last-child { border-bottom: none; }
  .role-badge {
    font-size: 10px; font-weight: 700;
    padding: 2px 7px; border-radius: 4px;
    background: rgba(91,181,162,0.15); color: var(--floyd);
    white-space: nowrap; min-width: 96px; text-align: center;
  }

  /* ── MAIN CONTENT ── */
  main {
    padding: 32px;
    overflow-y: auto;
  }

  /* Query area */
  .query-area {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
  }

  .query-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .query-modes {
    display: flex; gap: 8px; flex-wrap: wrap;
    margin-bottom: 16px;
  }

  /* ── TILANNEPAKETTI-KORTIT ── */
  .situation-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 16px;
  }

  .situation-card {
    background: var(--bg-card2);
    border: 2px solid var(--border);
    border-radius: 10px;
    padding: 14px 16px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    text-align: left;
  }

  .situation-card:hover {
    background: var(--bg-card);
    border-color: #4A5578;
  }

  .situation-card.active {
    border-color: var(--ritala);
    background: rgba(59,125,216,0.08);
  }

  .situation-card-icon { font-size: 20px; margin-bottom: 6px; }

  .situation-card-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 4px;
  }

  .situation-card-desc {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.5;
  }

  .situation-card-lenses {
    display: flex; gap: 4px; flex-wrap: wrap;
    margin-top: 8px;
  }

  .situation-lens-tag {
    font-size: 10px; font-weight: 700;
    padding: 2px 7px; border-radius: 4px;
  }

  textarea {
    width: 100%;
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.6;
    padding: 14px 16px;
    resize: vertical;
    min-height: 100px;
    outline: none;
    transition: border-color 0.15s;
  }
  textarea:focus { border-color: var(--ritala); }
  textarea::placeholder { color: var(--muted); }

  .query-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .lens-toggles {
    display: flex; gap: 6px; flex-wrap: wrap;
  }

  .lens-toggle {
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 5px;
    border: 1px solid;
    background: transparent;
    cursor: pointer;
    transition: opacity 0.15s;
    opacity: 0.5;
  }
  .lens-toggle.on { opacity: 1; }
  .lt-1a { color: var(--ritala);   border-color: var(--ritala); }
  .lt-1b { color: var(--floyd);    border-color: var(--floyd);  }
  .lt-2a { color: var(--kaplan);   border-color: var(--kaplan); }
  .lt-2b { color: var(--hoppmann); border-color: var(--hoppmann); }

  .run-btn {
    background: linear-gradient(135deg, var(--ritala), #5B4BD8);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 10px 22px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    display: flex; align-items: center; gap: 8px;
    transition: opacity 0.15s;
  }
  .run-btn:hover { opacity: 0.88; }
  .run-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .batch-add-btn {
    background: var(--bg-card2);
    color: var(--text);
    border: 1px solid var(--border);
  }
  .batch-add-btn:hover { opacity: 0.85; }

  /* ── BATCH PANEL ── */
  .batch-panel {
    max-width: 900px;
    margin: 0 auto 24px;
    padding: 16px 20px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .batch-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--text);
  }
  .batch-date { font-size: 12px; font-weight: 400; color: var(--muted); }

  .batch-queue-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }
  .batch-queue-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    background: var(--bg-card2);
    border: 1px solid var(--border);
    border-radius: 7px;
    font-size: 12px;
  }
  .batch-queue-item .bq-meta { color: var(--muted); }
  .batch-queue-item .bq-remove {
    background: none; border: none; color: var(--warning);
    cursor: pointer; font-size: 13px; padding: 2px 6px;
  }
  .batch-empty-hint { font-size: 12px; color: var(--muted); font-style: italic; }

  .batch-actions {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  }
  .batch-submit-btn {
    background: linear-gradient(135deg, var(--kaplan), #B8860B);
    color: #fff; border: none; border-radius: 8px;
    padding: 9px 18px; font-size: 13px; font-weight: 700;
    cursor: pointer; transition: opacity 0.15s;
  }
  .batch-submit-btn:hover { opacity: 0.88; }
  .batch-submit-btn:disabled { opacity: 0.35; cursor: not-allowed; }
  .batch-status-text { font-size: 12px; color: var(--muted); }

  .batch-results-list { display: flex; flex-direction: column; gap: 8px; margin-top: 14px; }
  .batch-result-item {
    display: flex; justify-content: space-between; align-items: center; gap: 10px;
    padding: 10px 12px; background: var(--bg-card2); border: 1px solid var(--border);
    border-radius: 7px; font-size: 12px;
  }
  .batch-result-item .br-view-btn {
    background: var(--ritala); color: #fff; border: none; border-radius: 6px;
    padding: 5px 12px; font-size: 11px; font-weight: 700; cursor: pointer;
  }
  .batch-result-item.errored { border-color: var(--warning); }
  .batch-result-item .br-error { color: var(--warning); }

  /* ── RESPONSE AREA ── */
  .response-area { display: none; }
  .response-area.visible { display: block; }

  .loading-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 32px;
    text-align: center;
  }

  .spinner {
    width: 36px; height: 36px;
    border: 3px solid var(--border);
    border-top-color: var(--ritala);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 16px;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .loading-steps {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
  }

  .loading-step {
    font-size: 12px;
    color: var(--muted);
    display: flex; align-items: center; gap: 6px;
  }
  .loading-step.done { color: var(--success); }
  .loading-step .step-icon { font-size: 14px; }

  /* Section cards */
  .section-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 16px;
    overflow: hidden;
  }

  .section-header {
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    user-select: none;
  }

  .section-header:hover { background: var(--bg-card2); }

  .section-meta {
    display: flex; align-items: center; gap: 12px;
  }

  .section-num {
    font-size: 11px;
    font-weight: 700;
    color: var(--muted);
    font-family: var(--font-mono);
    min-width: 26px;
  }

  .section-title {
    font-size: 14px;
    font-weight: 700;
  }

  .section-lenses {
    display: flex; gap: 5px;
  }

  .mini-pill {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
  }

  .section-toggle { color: var(--muted); font-size: 14px; transition: transform 0.2s; }
  .section-toggle.open { transform: rotate(180deg); }

  .section-body {
    padding: 20px;
    display: none;
  }
  .section-body.open { display: block; }

  /* Analysis blocks within sections */
  .analysis-block {
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 14px;
    font-size: 14px;
    line-height: 1.7;
    white-space: pre-wrap;
  }

  .analysis-block:last-child { margin-bottom: 0; }

  .block-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }

  /* Concept tags inline */
  .concept-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    font-family: var(--font-mono);
    padding: 1px 6px;
    border-radius: 3px;
    background: rgba(255,255,255,0.07);
    color: #CBD2E0;
    margin: 0 1px;
  }

  .tag-1a { background: rgba(59,125,216,0.15); color: var(--ritala); }
  .tag-1b { background: rgba(91,181,162,0.15); color: var(--floyd); }
  .tag-2a { background: rgba(212,168,67,0.15); color: var(--kaplan); }
  .tag-2b { background: rgba(194,110,191,0.15); color: var(--hoppmann); }

  /* Warning / concern block */
  .concern-block {
    border-left: 3px solid var(--success);
    background: rgba(91,181,122,0.06);
    border-radius: 0 8px 8px 0;
    padding: 14px 16px;
    margin-bottom: 14px;
    font-size: 14px;
  }

  .concern-block.misread {
    border-left-color: var(--warning);
    background: rgba(224,92,92,0.06);
  }

  .concern-label {
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.8px; margin-bottom: 6px;
  }

  /* Weak signals */
  .signal-row {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }
  .signal-row:last-child { border-bottom: none; }
  .signal-num {
    font-size: 20px; font-weight: 900;
    font-family: var(--font-mono);
    color: var(--border);
    min-width: 28px;
    line-height: 1.4;
  }

  /* Sources */
  .source-item {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 8px 0; border-bottom: 1px solid var(--border);
    font-size: 13px;
  }
  .source-item:last-child { border-bottom: none; }
  .source-type {
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    padding: 2px 7px; border-radius: 3px;
    white-space: nowrap; align-self: center;
    background: rgba(255,255,255,0.07); color: var(--muted);
  }
  .source-link { color: var(--ritala); text-decoration: none; }
  .source-link:hover { text-decoration: underline; }

  /* Factsheet button */
  .factsheet-btn {
    background: transparent;
    border: 1px solid var(--kaplan);
    color: var(--kaplan);
    border-radius: 7px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    display: flex; align-items: center; gap: 7px;
    transition: background 0.15s;
    margin-top: 8px;
  }
  .factsheet-btn:hover { background: rgba(212,168,67,0.1); }
  .factsheet-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* Error */
  .error-card {
    background: rgba(224,92,92,0.08);
    border: 1px solid rgba(224,92,92,0.3);
    border-radius: 10px;
    padding: 20px;
    color: var(--warning);
    font-size: 14px;
  }

  /* Scrollbar — näkyvä tummalla taustalla */
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: #1E2433; border-radius: 4px; }
  ::-webkit-scrollbar-thumb { background: #4A5578; border-radius: 4px; border: 2px solid #1E2433; }
  ::-webkit-scrollbar-thumb:hover { background: #6B7AA8; }
  * { scrollbar-width: thin; scrollbar-color: #4A5578 #1E2433; }

  /* Responsive */
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    aside { position: static; height: auto; border-right: none; border-bottom: 1px solid var(--border); }
    main { padding: 20px 16px; }
    header { padding: 14px 16px; }
    .lens-bar { padding: 10px 16px; }
  }

  /* ══ TULOSTUS / PDF (Ctrl-P) ══
     Piilotetaan kaikki UI-elementit ja näytetään vain analyysin tulokset
     siistissä valkoisessa asettelussa. */
  @media print {
    /* Pakotetaan valkea tausta — tumma teema ei tulostu hyvin */
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

    body { background: #fff !important; color: #111 !important; font-family: 'Calibri', 'Georgia', serif; }

    /* Piilota kaikki UI-osat paitsi vastausnäkymä */
    header, .lens-bar, aside, .query-area, .batch-panel,
    .situation-grid, #batchPanel, #batchAddBtn, #globalFactsheetBtn,
    .run-btn, .query-footer, .loading-card { display: none !important; }

    /* Layout: koko leveys ilman sivupalkkia */
